# SFTM - Street Fighter: The Movie (Incredible Technologies itech32)
# JTFRAME macro configuration. Evaluated with `jtframe cfgstr sftm`.

CORENAME=SFTM
# jtframe mem hardcodes a jt+core+_game_sdram name for the wrapper it
# generates, so GAMETOP must match it for `jtframe files syn` to add the right
# file to files.qip. This is internal only -- the core ships as sftm.rbf and
# the MRA <rbf> tag is rewritten to match (see docker/run-synth.sh). The 'jt'
# prefix is JOTEGO's and is not used for this core's distributed name.
GAMETOP=jtsftm_game_sdram

# Measured refresh (itech32 P/N 1083: VSync 59.7612 Hz)
JTFRAME_RATE=59.76

# Active video dimensions (MAME: visarea 0-383 h, 8-255 v)
JTFRAME_WIDTH=384
JTFRAME_HEIGHT=240

# 15-bit palette -> 5 bits per colour channel
JTFRAME_COLORW=5

# Horizontal game (do NOT define JTFRAME_VERTICAL)

# 6 action buttons (LP MP HP LK MK HK)
JTFRAME_BUTTONS=6

# Pixel clock: without this macro pxl_cen is declared OUTPUT from the game
# and must be driven by the game itself.  With JTFRAME_PXLCLK=8 the JTFRAME
# board generates it at 48 MHz / 6 = 8 MHz (≈ itech32's 7.96 MHz pixel clock)
# and delivers it as INPUT to the game.  This is required for arcade_video
# to sample pixels (its CE gating fires on rising edges of pxl_cen).
JTFRAME_PXLCLK=8

# --- Memory ------------------------------------------------------------------
# ~36 MB of ROM (see cfg/mem.yaml). Needs the 4 SDRAM banks AND the 128 MB
# module, because 4 x 8 MB = 32 MB on the standard module is not enough.
JTFRAME_SDRAM_BANKS
# 64 MB access: 4 x 16 MB banks (jtframe_emu.sv sets SDRAMW=23 for LARGE, 24
# for XL; jtframe_mem_ports.inc sizes ba*_addr to match, [22:0] vs [23:0]).
#
# THE GROM BUS MUST NOT EXCEED ONE BANK. A bus wider than its bank silently
# loses its top address bit: jtframe_romrq_bcache.v:114 forms the SDRAM address
# as offset + {{SDRAMW-AW{1'b0}}, addr_req}, and when AW > SDRAMW that
# replication width goes NEGATIVE and the high bits are simply dropped -- with
# no Quartus warning. That is what broke the graphics: grom was declared as one
# 32 MB bus (grom_addr[24:1], 24 bits) inside a 16 MB bank, so grom_addr[24]
# was discarded, everything at grom 0x1000000+ (the rm1 mask ROMs) aliased onto
# 0x0000000+, and rm1 -- downloading second -- overwrote rm0. Blits then read
# rm1 data at rm0 addresses.
#
# Confirmed on hardware: the passive probe in sftm_blit.v captured bytes 40 40
# at a grom_base ending in 0xCA. No address ending in 0xCA in the low 64 KB of
# rm0 holds 40 40; rm1 at 0x0000CA holds exactly that, and uniquely so.
#
# JTFRAME_SDRAM_XL is NOT the fix. It would give 32 MB banks, but it forbids
# JTFRAME_BA*_START and requires header.offset bank boundaries, and those must
# land on MAME region starts (mra/corerom.go iterates MAME's own regions, so
# mame2mra cannot split one). Bank 3 has to begin 0x2000000 bytes INTO the
# grom region, which no region start expresses -- bank 2 would have to hold all
# 32.5 MB of grom, 512 KB over even an XL bank.
#
# The fix is to split grom into two 16 MB buses, one per bank, selected on
# grom_addr[24] exactly as grm3 already is on bit 25. That fits 4 x 16 MB and
# therefore runs on 64 MB and 128 MB modules alike. See doc/PORTING.md.
JTFRAME_SDRAM_LARGE
#
# SDRAM bank byte-offset boundaries in the ROM download stream. The stream is
# maindata 1MB(0x100000), soundcpu 0x50000 (pad 0x10000 + ROM 0x40000),
# ensoniq.0 2MB(0x200000), ensoniq.3 512KB(0x80000), then the single grom
# region: rm0 16MB(0x1000000), rm1 16MB(0x1000000), grm3 512KB(0x80000).
#
#   BA0 0x0000000  main + snd + srom        0x3D0000  (3.8 MB)
#   BA1 0x03D0000  grom0 = rm0             0x1000000  (16 MB, fills the bank)
#   BA2 0x13D0000  grom1 = rm1             0x1000000  (16 MB, fills the bank)
#   BA3 0x23D0000  grm3 + vram + vramrd     ~0x180000 (1.5 MB)
#
# Every bank is <= 16 MB, so this layout also runs on a 64 MB module. Note the
# BA1/BA2 boundaries fall INSIDE the grom region; that is fine for the
# JTFRAME_BA*_START macros, which are plain byte offsets, but it is exactly
# what the JTFRAME_SDRAM_XL header.offset mechanism cannot express.
JTFRAME_BA1_START=0x3D0000
JTFRAME_BA2_START=0x13D0000
JTFRAME_BA3_START=0x23D0000
# Bank 3 hosts the vram R/W bus (Phase 2: VRAM lives in SDRAM, see
# doc/PHASE2-DESIGN.md), which requires write access to the bank.
JTFRAME_BA3_WEN
#
# NVRAM (0x600000-0x61ffff) is on-chip BRAM inside sftm_main. The low 32 KB is
# persisted to the SD card through the ioctl interface; MiSTer firmware
# mishandles dumps of 64 kB and above, and the operator settings (including the
# volume, which starts at zero and makes the game silent) live in the first
# 64 bytes. See cfg/mem.yaml.
JTFRAME_IOCTL_RD=32768

[mister]
# OSD extras for MiSTer
JTFRAME_OSD_VOL
# Disable HQ2x scandoubler (saves ~9.9k ALMs; hq2x_buf line buffers use FFs
# not block RAM, making it disproportionately expensive on Cyclone V).
# Replaced by simple 2x line doubler via jtframe_scan2x.v.
JTFRAME_NOHQ2X
