# JTFRAME / build artefacts
/release/
/rom/
/jtbin/
/modules/jtframe/
# jtframe mem generated outputs (do not commit)
cores/*/mist/
cores/*/mister/
# files.qip is generated by `jtframe files syn sftm --target mister`
files.qip
# Quartus installers are large binaries downloaded manually (see docker/quartus-installers/README.md)
docker/quartus-installers/*.run
docker/quartus-installers/*.qdz
cores/*/sidi/
cores/*/sidi128/
cores/*/pocket/
*.rbf
*.rom
*.sof
*.pof
*.qsf
*.qpf
db/
incremental_db/
output_files/
simulation/
*.vcd
*.fst
*.wlf
# ghdl synth output (generated artifact, not committed)
cores/*/hdl/tg68k/TG68KdotC_Kernel_conv.v
# ROMs are never committed
*.zip
*.7z
# NVRAM images are game-derived data and are not distributed. sftm_main.v
# $readmemh's the two .hex files at synthesis time -- generate them from your
# own MAME dump with doc/make_nvram_hex.py before building.
/nvram32
cores/*/hdl/nvram_hi.hex
cores/*/hdl/nvram_lo.hex
cores/*/ver/lint/nvram_hi.hex
cores/*/ver/lint/nvram_lo.hex
# Agent working notes, not part of the core
/AGENTS.md
# macOS
.DS_Store
# MAME driver source vendored locally for porting reference (BSD-3-Clause,
# kept out of this GPLv3 repo; run doc/fetch-mame-src.sh to refetch)
/doc/mame-src/
